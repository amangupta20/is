# Copy this file to ignored deploy/.env.assistant for local Compose interpolation.
# In Dokploy, store real values in its secret/configuration UI instead of Git.
# Use the already-verified Supavisor endpoint and assistant_core role for the DB URL.
ASSISTANT_ENVIRONMENT=production
ASSISTANT_DATABASE_URL=postgresql+asyncpg://assistant_core:REPLACE_WITH_DATABASE_PASSWORD@REPLACE_WITH_VERIFIED_SUPAVISOR_HOST:6543/postgres
# Generate a NEW random secret of at least 32 bytes; share it only with adapter Valves.
ASSISTANT_HMAC_SECRET=REPLACE_WITH_NEW_RANDOM_VALUE_OF_AT_LEAST_32_BYTES
# Optional dedicated admin token for web dashboard (defaults to ASSISTANT_HMAC_SECRET if omitted)
ASSISTANT_ADMIN_TOKEN=
ASSISTANT_REQUEST_CLOCK_SKEW_SECONDS=60
ASSISTANT_CONTEXT_TIMEOUT_SECONDS=1.5
# Open WebUI API configuration for background document fetching
ASSISTANT_OPEN_WEBUI_URL=http://open-webui:8080
ASSISTANT_OPEN_WEBUI_API_KEY=
ASSISTANT_FILE_INDEXING_TIMEOUT_SECONDS=30
# The worker requires a base URL and model before it starts extraction. An API key is optional for internal proxies.
ASSISTANT_TASK_MODEL_BASE_URL=https://REPLACE_WITH_TASK_MODEL_ENDPOINT/v1
ASSISTANT_TASK_MODEL_API_KEY=
ASSISTANT_TASK_MODEL_MODEL=REPLACE_WITH_CHEAP_MODEL
ASSISTANT_TASK_MODEL_TIMEOUT_SECONDS=15
# Conversation indexing and retrieval use one input per OpenAI-compatible request.
ASSISTANT_EMBEDDING_BASE_URL=https://REPLACE_WITH_EMBEDDING_ENDPOINT/v1
ASSISTANT_EMBEDDING_API_KEY=
ASSISTANT_EMBEDDING_MODEL=REPLACE_WITH_EMBEDDING_MODEL
ASSISTANT_EMBEDDING_DIMENSION=1536
ASSISTANT_EMBEDDING_TIMEOUT_SECONDS=15
ASSISTANT_LOG_LEVEL=INFO
# Leave empty to disable OTLP export.
ASSISTANT_OTLP_ENDPOINT=
# Local tag for the image Compose builds from the checked-out Git source. Override if needed.
ASSISTANT_IMAGE=assistant-core:local
ASSISTANT_NETWORK=REPLACE_WITH_PRIVATE_DOCKER_NETWORK
