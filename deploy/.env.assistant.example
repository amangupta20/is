# Copy this file to ignored deploy/.env.assistant for local Compose interpolation.
# In Dokploy, store real values in its secret/configuration UI instead of Git.
# Use the already-verified Supavisor endpoint and assistant_core role for the DB URL.
ASSISTANT_ENVIRONMENT=production
ASSISTANT_DATABASE_URL=postgresql+asyncpg://assistant_core:REPLACE_WITH_DATABASE_PASSWORD@REPLACE_WITH_VERIFIED_SUPAVISOR_HOST:6543/postgres
# Generate a NEW random secret of at least 32 bytes; share it only with adapter Valves.
ASSISTANT_HMAC_SECRET=REPLACE_WITH_NEW_RANDOM_VALUE_OF_AT_LEAST_32_BYTES
ASSISTANT_REQUEST_CLOCK_SKEW_SECONDS=60
ASSISTANT_CONTEXT_TIMEOUT_SECONDS=1.5
ASSISTANT_LOG_LEVEL=INFO
# Leave empty to disable OTLP export.
ASSISTANT_OTLP_ENDPOINT=
# Use one registry digest that is available for both amd64 and arm64.
ASSISTANT_IMAGE=registry.example.invalid/assistant-core@sha256:REPLACE_WITH_IMMUTABLE_DIGEST
ASSISTANT_NETWORK=REPLACE_WITH_PRIVATE_DOCKER_NETWORK
